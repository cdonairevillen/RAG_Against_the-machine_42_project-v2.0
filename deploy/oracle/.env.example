# Copy to deploy/oracle/.env on the server and fill in.
# The public name of the server (a free DuckDNS subdomain, for example).
RAG_DOMAIN=<your-name>.duckdns.org
# Web origins allowed to call the API: the GitHub Pages site, or * for any.
RAG_ALLOWED_ORIGINS=https://<your-github-user>.github.io
# Where the index bundle is (default: ~/rag/bundle).
# BUNDLE_DIR=/home/ubuntu/rag/bundle
