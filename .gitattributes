# Line endings: LF everywhere in the repository and the working tree.
# Matches the 42 Linux machines, GNU make and uv (which always writes LF).
* text=auto eol=lf

# The SDK provided by 42 is never modified, not even its line endings.
llm_sdk/** -text

# Binary artefacts: never converted, never diffed as text.
*.npy binary
*.pyc binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.mp3 binary
*.mp4 binary
*.wav binary
